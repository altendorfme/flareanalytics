{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flareanalytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route everything through the Worker for X-Robots-Tag and AI crawler blocking (src/worker/index.ts).
    "run_worker_first": true
  },
  // :15 hourly collection, :45 daily maintenance. Split so each run fits the Free plan's 10 ms CPU.
  "triggers": { "crons": ["15 * * * *", "45 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareanalytics",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // IANA time zone used to split days (e.g. America/Sao_Paulo, UTC).
    "TIMEZONE": "America/Sao_Paulo",
    "MAX_SITES": "40",
    "SITES_PER_QUERY": "5",
    "DAILY_WRITE_BUDGET": "80000",
    "HOURLY_RETENTION_DAYS": "30",
    // 50000 (~6 ms) fits the Free plan CPU limit; use 100000 (max) on Paid.
    "PBKDF2_ITERATIONS": "50000"
  },
  // Login, setup and invite attempts: 5 per 60 s per IP + email.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "4801", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Required secret: wrangler secret put APP_KEY
}
